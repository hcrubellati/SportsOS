{
  "name": "sportsos",
  "version": "1.0.0",
  "description": "Open-source operational system for sports organizations — Salesforce-style object engine with a Smart TV OS interface and embedded MCP server.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "mcp:stdio": "node src/mcp/stdio-server.js",
    "reset-db": "rm -f data/sportsos-db.json && node src/server.js --seed-only",
    "test": "node src/verify.js"
  },
  "keywords": [
    "sports",
    "sports-tech",
    "operating-system",
    "custom-objects",
    "mcp",
    "model-context-protocol",
    "tv-ui",
    "football",
    "orchestration"
  ],
  "author": "SportsOS Community",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  }
}
